{
  "version": 1,
  "name": "less",
  "kind": "application",
  "origin": {
    "repository": "https://github.com/roolrz/HypeR",
    "commit": "8d42d047058a2b58a291803700e86487fb723f7a"
  },
  "sources": {
    "Cargo.toml": "app/less/Cargo.toml",
    "component.mk": "app/less/component.mk",
    "src/lib.rs": "app/less/src/lib.rs",
    "src/main.rs": "app/less/src/main.rs",
    "tests/content.rs": "app/less/tests/content.rs"
  },
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "mounts": {
    "": "app/less"
  },
  "packages": [
    "hyper-less"
  ],
  "tests": [
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-less"
    ]
  ],
  "cargo_context": {
    "Cargo.toml": {
      "workspace": null,
      "membership": "..",
      "dependency_paths": {
        "target.cfg(target_os = \"hyper\")/dependencies/hyper-text-ui-shared": "lib/text-ui/shared",
        "target.cfg(target_os = \"hyper\")/dependencies/hyper-clap-shared": "lib/clap",
        "target.cfg(not(target_os = \"hyper\"))/dependencies/hyper-text-ui": "lib/text-ui"
      },
      "inherited_dependencies": {
        "/dependencies/clap": {
          "workspace": true
        },
        "/dependencies/hyper-os": {
          "workspace": true
        },
        "/dependencies/hyper-rt": {
          "workspace": true
        },
        "target.cfg(target_os = \"hyper\")/dependencies/hyper-text-ui-shared": {
          "workspace": true
        },
        "target.cfg(target_os = \"hyper\")/dependencies/hyper-clap-shared": {
          "workspace": true
        },
        "target.cfg(not(target_os = \"hyper\"))/dependencies/hyper-text-ui": {
          "workspace": true
        }
      }
    }
  }
}
